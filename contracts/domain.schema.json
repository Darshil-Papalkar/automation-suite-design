        },
        "target_repository_id": {
          "type": "string",
          "minLength": 1
        },
        "target_suite_root": {
          "type": "string",
          "minLength": 1
        },
        "target_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ordered_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "oracle_id": {
          "type": "string",
          "minLength": 1
        },
        "oracle_revision": {
          "type": "integer",
          "minimum": 1
        },
        "oracle_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reusable_abstractions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "environment_dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cleanup_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "scenario_id",
        "stable_scenario_key",
        "requirement_ids",
        "coverage_disposition",
        "existing_test_refs",
        "layer",
        "target_repository_id",
        "target_suite_root",
        "target_paths",
        "preconditions",
        "ordered_actions",
        "oracle_id",
        "oracle_revision",
        "oracle_sha256",
        "reusable_abstractions",
        "environment_dependencies",
        "cleanup_requirements",
        "blockers"
      ],
      "additionalProperties": false
    },
    "CriterionDisposition": {
      "type": "object",
