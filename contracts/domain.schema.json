          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "input_manifest_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "target_repository_id": {
          "type": "string",
          "minLength": 1
        },
        "base_commit_sha": {
          "type": "string",
          "minLength": 1
