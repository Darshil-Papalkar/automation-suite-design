      "required": [
        "path",
        "operation",
        "before_sha256",
        "after_sha256",
        "scenario_ids",
        "purpose"
      ],
      "additionalProperties": false
    },
    "PatchManifest": {
      "type": "object",
      "properties": {
        "patch_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
