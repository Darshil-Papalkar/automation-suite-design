          "type": "string",
          "minLength": 1
        },
        "scenario_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "disposition": {
          "type": "string",
          "enum": [
            "existing",
            "extend_existing",
            "new",
            "blocked",
            "out_of_scope",
            "not_automatable"
