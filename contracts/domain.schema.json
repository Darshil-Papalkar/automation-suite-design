      "required": [
        "repository_id",
        "commit_sha",
        "module_root",
        "framework_name",
        "framework_version",
        "adapter_id",
        "adapter_version",
        "capabilities",
        "test_roots",
        "naming_patterns",
        "command_ids",
        "reusable_abstraction_refs",
        "evidence_refs",
        "execution_readiness",
        "unresolved_items"
      ],
      "additionalProperties": false
    },
