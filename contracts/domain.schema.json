{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/testagent/domain/1.0",
  "title": "Test agent domain starter contracts",
  "description": "Design contracts. Validate named definitions. Semantic rules and artifact-type/payload mapping remain required.",
  "$defs": {
    "JobState": {
      "type": "string",
      "enum": [
        "QUEUED",
        "RUNNING",
        "WAITING_INPUT",
        "WAITING_ENVIRONMENT",
        "WAITING_REVIEW",
        "READY_TO_PUBLISH",
        "PUBLISHING",
        "WAITING_CI",
        "CANCELLING",
        "COMPLETED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "Stage": {
      "type": "string",
      "enum": [
        "AUTHORIZE",
        "SNAPSHOT",
        "DISCOVER",
        "BASELINE",
        "NORMALIZE",
        "RETRIEVE",
        "PLAN",
        "GENERATE",
        "VALIDATE",
        "DIAGNOSE",
        "REPAIR",
        "REVIEW",
        "FRESHNESS",
        "PUBLISH",
        "CI",
        "CLEANUP"
      ]
    },
    "QualityOutcome": {
      "type": "string",
      "enum": [
        "UNASSESSED",
        "VERIFIED",
        "VERIFIED_DEFECT_EXPOSING",
        "SUSPECTED_PRODUCT_DEFECT",
        "PARTIAL",
        "BLOCKED",
        "UNVERIFIED",
        "REJECTED"
      ]
    },
    "DeliveryKind": {
      "type": "string",
      "enum": [
        "no_change",
        "artifact_only",
        "branch",
        "draft_pr"
      ]
    },
    "TestLayer": {
      "type": "string",
      "enum": [
        "unit",
        "component",
        "integration",
        "contract",
        "api",
        "ui",
        "performance"
      ]
    },
    "SourceRef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "jira_issue",
            "confluence_page",
            "snapshot"
          ]
        },
        "connection_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "external_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "connection_id",
        "external_id"
      ],
      "additionalProperties": false
    },
    "RepositoryRef": {
      "type": "object",
      "properties": {
        "repository_id": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "application",
            "automation",
            "contract"
          ]
        }
      },
      "required": [
        "repository_id",
        "ref",
        "role"
      ],
      "additionalProperties": false
    },
    "Limits": {
      "type": "object",
      "properties": {
        "wall_clock_seconds": {
          "type": "integer",
          "minimum": 60
        },
        "model_cost_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "repair_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      },
      "required": [
        "wall_clock_seconds",
        "model_cost_usd",
        "repair_attempts"
      ],
      "additionalProperties": false
    },
    "Scope": {
      "type": "object",
      "properties": {
        "suite_roots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "test_layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TestLayer"
          }
        },
        "scenario_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      },
      "required": [
        "suite_roots",
        "test_layers",
        "scenario_limit"
      ],
      "additionalProperties": false
    },
    "JobRequest": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1
        },
        "repository_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RepositoryRef"
          },
          "minItems": 1
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "environment_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "publication_mode": {
          "type": "string",
          "enum": [
            "artifact_only",
            "branch",
            "draft_pr"
          ]
        },
        "limits": {
          "$ref": "#/$defs/Limits"
        },
        "allow_unverified_draft": {
          "type": "boolean"
        },
        "generation_revision": {
          "type": "integer",
          "minimum": 1
        },
        "replaces_job_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "project_id",
        "source_refs",
        "repository_refs",
        "scope",
        "environment_id",
        "publication_mode",
        "limits"
      ],
      "additionalProperties": false
    },
    "JobAccepted": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "$ref": "#/$defs/JobState"
        },
        "stage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stage"
            },
            {
              "type": "null"
            }
          ]
        },
        "quality_outcome": {
          "$ref": "#/$defs/QualityOutcome"
        },
        "status_url": {
          "type": "string",
          "minLength": 1
        },
        "events_url": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "job_id",
        "state",
        "stage",
        "quality_outcome",
        "status_url",
        "events_url"
      ],
      "additionalProperties": false
    },
    "JobStatus": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "$ref": "#/$defs/JobState"
        },
        "stage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stage"
            },
            {
              "type": "null"
            }
          ]
        },
        "quality_outcome": {
          "$ref": "#/$defs/QualityOutcome"
        },
        "delivery_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeliveryKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "merge_eligible": {
          "type": "boolean"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "projection_updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "blocker_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verification_limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "job_id",
        "state",
        "stage",
        "quality_outcome",
        "delivery_kind",
        "merge_eligible",
        "version",
        "projection_updated_at",
        "blocker_ids",
        "artifact_ids",
        "verification_limitations"
      ],
      "additionalProperties": false
    },
    "EvidenceRef": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_id",
        "revision",
        "content_sha256",
        "location",
        "url"
      ],
      "additionalProperties": false
    },
    "RequirementSpec": {
      "type": "object",
      "properties": {
        "requirement_id": {
          "type": "string",
          "minLength": 1
        },
        "stable_criterion_key": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "normative_statement": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          }
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "expected_outcomes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "resolved",
            "ambiguous",
            "conflicting",
            "not_testable",
            "out_of_scope"
          ]
        },
        "authority_resolution": {
          "type": "string",
          "minLength": 1
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "requirement_id",
        "stable_criterion_key",
        "revision",
        "title",
        "normative_statement",
        "source_refs",
        "preconditions",
        "action",
        "expected_outcomes",
        "status",
        "authority_resolution",
        "questions"
      ],
      "additionalProperties": false
    },
    "OracleAssertion": {
      "type": "object",
      "properties": {
        "assertion_id": {
          "type": "string",
          "minLength": 1
        },
        "behavior_statement": {
          "type": "string",
          "minLength": 1
        },
        "observable": {
          "type": "string",
          "minLength": 1
        },
        "comparison_operator": {
          "type": "string",
          "minLength": 1
        },
        "expected_value_or_invariant": {},
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          }
        },
        "provenance": {
          "type": "string",
          "enum": [
            "requirement",
            "contract",
            "approved_invariant"
          ]
        },
        "temporal_bound": {
          "type": [
            "string",
            "null"
          ]
        },
        "tolerance_policy": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "assertion_id",
        "behavior_statement",
        "observable",
        "comparison_operator",
        "expected_value_or_invariant",
        "evidence_refs",
        "provenance",
        "temporal_bound",
        "tolerance_policy"
      ],
      "additionalProperties": false
    },
    "AssertionOracle": {
      "type": "object",
      "properties": {
        "oracle_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OracleAssertion"
          },
          "minItems": 1
        },
        "prohibited_weakening": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "review_state": {
          "type": "string",
          "enum": [
            "policy_accepted",
            "human_accepted",
            "needs_resolution"
          ]
        }
      },
      "required": [
        "oracle_id",
        "revision",
        "assertions",
        "prohibited_weakening",
        "review_state"
      ],
      "additionalProperties": false
    },
    "AdapterCapabilities": {
      "type": "object",
      "properties": {
        "supports_collection": {
          "type": "boolean"
        },
        "supports_test_selection": {
          "type": "boolean"
        },
        "supports_machine_readable_results": {
          "type": "boolean"
        },
        "supports_coverage": {
          "type": "boolean"
        },
        "supports_mutation": {
          "type": "boolean"
        },
        "supports_parallel_workers": {
          "type": "boolean"
        },
        "supports_browser_artifacts": {
          "type": "boolean"
        },
        "supports_parameterized_test_ids": {
          "type": "boolean"
        },
        "requires_external_environment": {
          "type": "boolean"
        }
      },
      "required": [
        "supports_collection",
        "supports_test_selection",
        "supports_machine_readable_results",
        "supports_coverage",
        "supports_mutation",
        "supports_parallel_workers",
        "supports_browser_artifacts",
        "supports_parameterized_test_ids",
        "requires_external_environment"
      ],
      "additionalProperties": false
    },
    "RepositoryProfile": {
      "type": "object",
      "properties": {
        "repository_id": {
          "type": "string",
          "minLength": 1
        },
        "commit_sha": {
          "type": "string",
          "minLength": 1
        },
        "module_root": {
          "type": "string",
          "minLength": 1
        },
        "framework_name": {
          "type": "string",
          "minLength": 1
        },
        "framework_version": {
          "type": "string",
          "minLength": 1
        },
        "adapter_id": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "$ref": "#/$defs/AdapterCapabilities"
        },
        "test_roots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "naming_patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "command_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reusable_abstraction_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          }
        },
        "execution_readiness": {
          "type": "string",
          "enum": [
            "ready",
            "dependency_missing",
            "unsupported",
            "unverified"
          ]
        },
        "unresolved_items": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
